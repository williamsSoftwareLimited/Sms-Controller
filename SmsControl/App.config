<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <appSettings>
        <!-- PLC Connection Settings -->
        <add key="PLC_IP_ADDRESS" value="192.168.1.100" />
        <add key="PLC_PORT" value="20257" />
        <add key="PLC_CONNECTION_TIMEOUT" value="3000" />
        <add key="PLC_RETRIES" value="3" />
    </appSettings>
</configuration>